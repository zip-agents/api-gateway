# Local settings for docker compose. `make env` copies this to .env with generated secrets.
# .env is gitignored. On AWS these come from Secrets Manager (docs/deployment.md).

# API keys accepted by the gateway: name:secret pairs, comma-separated, secrets >= 32 chars.
GATEWAY_API_KEYS=local:replace-with-at-least-32-random-characters
# Signs the docs portal's session cookie. >= 32 characters.
GATEWAY_SESSION_SECRET=replace-with-at-least-32-random-characters
# Host port the gateway is published on.
GATEWAY_PORT=8080

# The key the smoke tests use (the secret part of one GATEWAY_API_KEYS entry).
SMOKE_API_KEY=replace-with-at-least-32-random-characters
# Services the smoke tests and `make perf` cover.
SMOKE_SERVICES=claude,grok,dsh

# Sign-in and invite links run against the local fake-cognito (docker-compose.yml): no
# cloud account needed. Its hosted login and outbox: http://localhost:9229 (FAKE_COGNITO_PORT).
# FAKE_COGNITO_PORT=9229
