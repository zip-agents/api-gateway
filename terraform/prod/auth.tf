# Accounts for the portal: the Cognito user pool (invite-only; see modules/cognito-pool).
# The pool, its users and their invites are destroyed with this stack (`make aws-down`).

data "aws_caller_identity" "current" {}

module "auth" {
  source = "../modules/cognito-pool"

  name          = local.name
  domain_prefix = "${local.name}-${data.aws_caller_identity.current.account_id}"
  login_url     = "https://${var.domain_name}/account/login"
  callback_urls = ["https://${var.domain_name}/account/auth/callback"]
  logout_urls   = ["https://${var.domain_name}/account/login"]
}

# The app client's secret, for the gateway (GATEWAY_COGNITO_CLIENT_SECRET). Unlike the API
# keys it is generated by Cognito, so it is in this stack's state: encrypted, in the
# private state bucket that only administrators and the platform CI role can read.
resource "aws_secretsmanager_secret" "cognito" {
  name                    = "${local.project}/${local.environment}/cognito"
  description             = "client_secret of the gateway's Cognito app client."
  recovery_window_in_days = 0 # teardown deletes it at once
}

resource "aws_secretsmanager_secret_version" "cognito" {
  secret_id     = aws_secretsmanager_secret.cognito.id
  secret_string = jsonencode({ client_secret = module.auth.client_secret })
}
